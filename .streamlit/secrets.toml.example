# Streamlit Community Cloud 的 Secrets 設定範本（部署步驟見 docs/deploy.md）
# 在 share.streamlit.io → 你的 App → Settings → Secrets 貼上以下內容，換成 Supabase 的連線資訊。
# 不要把真正的 secrets.toml 放進 git（.gitignore 已排除 .streamlit/secrets.toml）。

[database]
# Supabase → Project Settings → Database → Connection string → 選「Session pooler」，
# 把開頭的 postgresql:// 改成 postgresql+pg8000://，並把 [YOUR-PASSWORD] 換成建立專案時設定的資料庫密碼
url = "postgresql+pg8000://postgres.xxxxxxxxxxxxxxxxxxxx:你的資料庫密碼@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
