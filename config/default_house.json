    {"id": "bedroom_2", "name": "次臥 2", "template": "bedroom", "area_ping": 3.5, "orientation": "N"},
    {"id": "living_room", "name": "客廳", "template": "living_room", "area_ping": 8, "orientation": "S"},
    {"id": "kitchen", "name": "廚房", "template": "kitchen", "area_ping": 3, "orientation": "E"},
    {"id": "bathroom_1", "name": "浴室 1", "template": "bathroom", "area_ping": 1.5, "orientation": "N"},
    {"id": "bathroom_2", "name": "浴室 2", "template": "bathroom", "area_ping": 1.5, "orientation": "N",
     "remove_appliances": ["bath_heater"]},
    {"id": "utility", "name": "公共設備", "template": "utility",
